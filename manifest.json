{
   "action": {
      "default_icon": "label/icons/icon.png"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "label/css/waspeed.css", "content/assets/css/style.css", "content.css" ],
      "js": [ "content/index.js" ],
      "matches": [ "https://web.whatsapp.com/*" ]
   } ],
   "description": "KiamberCRM PRO es un CRM para WhatsApp Web. Organiza tus chats y optimiza tu negocio en WhatsApp Web.",
   "icons": {
      "128": "label/icons/icon.png"
   },
   "manifest_version": 3,
   "name": "KiamberCRM PRO",
   "permissions": [ "unlimitedStorage", "storage", "alarms", "tabs" ],
   "host_permissions": [
      "https://web.whatsapp.com/*",
      "https://*.wascript.com.br/*", 
      "https://catalogo.alwaysdata.net/*",
      "https://*.watidy.com/*"
   ],
   "version": "7.4.2.19",
   "web_accessible_resources": [ {
      "matches": [ "https://web.whatsapp.com/*" ],
      "resources": [ 
         "*.js", "*.css", "*.png", "*.mp3", "*.ttf", "*.json",
         "label/*", "label/css/*", "label/icons/*", "label/config/*",
         "content/*", 
         "content/assets/js/*", "content/assets/css/*", "content/assets/png/*", "content/assets/mp3/*", "content/assets/ttf/*",
         "crm/*", 
         "crm/assets/js/*", "crm/assets/css/*", "crm/assets/png/*", "crm/assets/ttf/*", "crm/src/*",
         "fluxo/*", 
         "fluxo/assets/js/*", "fluxo/assets/css/*", "fluxo/assets/png/*", "fluxo/assets/ttf/*", "fluxo/src/*",
         "funnil/*", 
         "funnil/assets/js/*", "funnil/assets/css/*", "funnil/assets/png/*", "funnil/assets/ttf/*", "funnil/src/*",
         "whatsapp/*"
      ]
   } ]
}